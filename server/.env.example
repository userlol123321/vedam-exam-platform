# Server
PORT=5000
NODE_ENV=development
# Set to 1 when running behind Render/nginx so rate limits see real client IPs
TRUST_PROXY=0

# Database (Neon PostgreSQL free tier)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vedam_exam

# JWT - MUST be a long random string. Server refuses to start without it in production.
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=8h

# CORS (comma-separated origins; "null" is always allowed for the packaged Electron app)
CORS_ORIGIN=http://localhost:5173

# Super Admin (platform service owner) seeded login
SUPER_ADMIN_EMAIL=platform@vedam.app
SUPER_ADMIN_PASSWORD=superadmin123

# Judge0 code grader:
#  - LOCAL:  built-in localRunner only (no key/Docker). Requires python3 & a JDK
#            installed on the host for python/java; node is always available.
#  - HYBRID: local runtime first; languages without a local runtime (e.g. Java on
#            Render's native Node instance, which has no JDK) are executed via the
#            online compiler below. NO Docker needed for Java on Render.
#  - ONLINE: route all coding execution through onlinecompiler.io (Python + Java;
#            JavaScript keeps running locally since onlinecompiler.io has no Node).
#            Best for Render — no python3/JDK needed on the instance at all.
#  - SELF_HOSTED / CLOUD: Judge0-compatible API.
# Note: ONLINE/HYBRID require an internet connection to grade Python/Java. For
# fully offline LAN exams keep LOCAL and install a JDK alongside the server.
JUDGE0_MODE=HYBRID
JUDGE0_BASE_URL=http://localhost:2358
JUDGE0_RAPID_API_KEY=
JUDGE0_RAPID_HOST=judge0-ce.p.rapidapi.com

# Online compiler (onlinecompiler.io) — free up to 1M requests/month, no credit
# card. Sign up at https://api.onlinecompiler.io -> API Keys, create a key, paste
# it here. Used by HYBRID mode for languages without a local runtime.
ONLINE_COMPILER_BASE_URL=https://api.onlinecompiler.io
ONLINE_COMPILER_API_KEY=
# Students can bring their own onlinecompiler.io key (BYOK); used when the
# platform key above is absent. Burst protection — onlinecompiler.io allows only
# ~4 concurrent sync executions per account, and returns HTTP 429 above that.
# Hard cap on in-flight grading (default 4) and retries after 429/5xx (default 3).
ONLINE_COMPILER_CONCURRENCY=4
ONLINE_COMPILER_RETRIES=3

# Google Gemini code execution — FREE Python sandbox (numpy, pandas, matplotlib,
# scipy, sklearn, sympy, tensorflow pre-installed). Sign up at
# https://aistudio.google.com/apikey and add the key. Used as an automatic
# fallback for Python code that imports third-party libraries missing from the
# primary judge (e.g. onlinecompiler.io ships only stdlib). Python only.
# Optional — numpy/pandas questions keep working everywhere this is set.
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Transient (429/503) retries for the free-tier Gemini API — default 3.
GEMINI_API_RETRIES=3